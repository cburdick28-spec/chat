# Postgres connection string (Neon works great, one-click from the Vercel Marketplace).
# Leave empty in local dev and the app uses a throwaway local database in ./.data
DATABASE_URL=

# Signs the login cookies. Generate one: openssl rand -base64 32
AUTH_SECRET=

# Username/password sign-up is locked behind this code. Unset = sign-ups off.
INVITE_CODE=

# Google sign-in (optional). Leave blank to hide the Google button.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated Gmail addresses allowed in via Google
ALLOWED_EMAILS=
